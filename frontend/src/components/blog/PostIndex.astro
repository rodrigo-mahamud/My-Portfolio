---
import type { HeadingItem } from '../../utils/richTextUtils';

export interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
---

<aside
  class="sticky top-32 h-0 hidden md:w-[9vw] lg:w-[14vw] 2xl:w-[9vw] 3xl:w-[12vw] ml-auto md:flex flex-col items-center z-50"
>
  <div class="flex flex-col items-start">
    <ul class="pt-5">
      {
        headings.map((heading) => (
          <li class="flex flex-row items-center mb-4 magnetic" data-strength="0.5">
            <span class="text-xs">
              <a 
                class="post-index-link text-gray-400 cursor-none" 
                href={`#${heading.id}`}
                data-heading-level={heading.tag}
                style={{
                  paddingLeft: `${(heading.level - 1) * 0.5}rem`
                }}
              >
                {heading.text}
              </a>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
<script>
  import { gsap } from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const headingElements = document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]');
      let currentActiveLink = null;
      
      function setActiveLink(newActiveId) {
        // Desactivar el enlace anterior si existe
        if (currentActiveLink && currentActiveLink !== newActiveId) {
          const previousLink = document.querySelector(`a[href="#${currentActiveLink}"]`);
          if (previousLink) {
            gsap.to(previousLink, {
              color: '#9CA3AF',
              marginLeft: '0',
              duration: 0.3,
              ease: 'Expo.easeOut',
            });
          }
        }
        
        // Activar el nuevo enlace
        if (newActiveId) {
          const newLink = document.querySelector(`a[href="#${newActiveId}"]`);
          if (newLink) {
            gsap.to(newLink, {
              color: '#fff',
              marginLeft: '0.25rem',
              duration: 0.3,
              ease: 'Expo.easeOut',
            });
          }
        }
        
        currentActiveLink = newActiveId;
      }
      
      headingElements.forEach((heading, index) => {
        const headingId = heading.id;
        if (!headingId) return;
        
        ScrollTrigger.create({
          trigger: heading,
          start: 'top 60%',
          end: 'bottom 40%',
          onEnter: () => setActiveLink(headingId),
          onEnterBack: () => setActiveLink(headingId),
          onLeave: () => {
            // Solo desactivar si es el último elemento o si no hay siguiente
            if (index === headingElements.length - 1) {
              setActiveLink(null);
            }
          },
          onLeaveBack: () => {
            // Solo desactivar si es el primer elemento o si no hay anterior
            if (index === 0) {
              setActiveLink(null);
            }
          }
        });
      });
    }, 100);
  });
</script>
