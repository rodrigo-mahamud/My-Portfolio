---
import type { SinglePostInfoBlock } from '../../../utils/payload';
import { payloadAPI } from '../../../utils/payload';

export interface Props {
  block: SinglePostInfoBlock;
}

const { block } = Astro.props;
const overviewHTML = payloadAPI.richTextToHTML(block.overview);
const teamHTML = block.team ? payloadAPI.richTextToHTML(block.team) : '';
---

<div class="animate-on-scroll px-4 sm:px-6 py-8 mb-8" data-type="simple" data-duration="1.5" data-easing="Expo.easeOut">
  <div class="max-w-4xl mx-auto">
    {block.title && (
      <h2 class="text-2xl font-bold text-white mb-6">{block.title}</h2>
    )}
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Project Details -->
      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Role</h3>
          <p class="text-white">{block.rol}</p>
        </div>
        
        <div>
          <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Status</h3>
          <p class="text-white capitalize">{block.status}</p>
        </div>
        
        <div>
          <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Duration</h3>
          <p class="text-white">{block.duration}</p>
        </div>
      </div>
      
      <!-- Overview -->
      <div class="md:col-span-2">
        <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Project Overview</h3>
        <div class="prose prose-lg text-white max-w-none" set:html={overviewHTML} />
        
        {teamHTML && (
          <div class="mt-6">
            <h4 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Team</h4>
            <div class="text-white" set:html={teamHTML} />
          </div>
        )}
      </div>
    </div>
  </div>
</div>