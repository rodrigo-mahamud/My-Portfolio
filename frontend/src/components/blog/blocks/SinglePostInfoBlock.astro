---
// Payload-driven version of the original SinglePostInfo.astro — identical markup,
// data sourced from the Works `layout` block instead of MDX frontmatter.
import { Icon } from 'astro-icon/components';
import { payloadAPI } from '../../../utils/payload';

const { block } = Astro.props;
const overviewHTML = payloadAPI.richTextToHTML(block.overview);
const teamHTML = block.team ? payloadAPI.richTextToHTML(block.team) : '';
const status = (block.status || '').toString();
const statusClass =
  status.toLowerCase() === 'done'
    ? 'text-green-500'
    : status.toLowerCase() === 'in progress'
    ? 'text-yellow-500'
    : '';
---

<section id="overview" class="mx-auto pt-16">
  <div class="flex flex-col md:flex-row justify-between">
    <div
      class="md:w-1/3 animate-on-scroll mb-8 md:mb-0"
      data-type="simple"
      data-duration="1.5"
      data-easing="Expo.easeOut"
    >
      <div class="mb-8">
        <h2 class="text-lg font-bold mb-1 text-white">My Role</h2>
        <p class="text-base font-bold">{block.rol}</p>
      </div>
      <div class="mb-8">
        {block.title && <h2 class="text-lg font-bold mb-1 text-white">{block.title}</h2>}
        {teamHTML && (
          <div id="text" class="text-base leading-normal line-clamp-[22] relative -z-10" set:html={teamHTML} />
        )}
        {teamHTML && (
          <div class="w-full mt-4 shadow-[0px_20px_65px_100px_#0a0118] text-white">
            <div id="viewMore" class="magnetic w-fit flex justify-center text-sm items-center" data-strength=".5">
              <Icon id="viewMoreIcon" name="chevron-down" class="stroke-1 text-xl mr-1" />
              <span id="viewMoreText">View all</span>
            </div>
          </div>
        )}
        {!teamHTML && (
          <div class="mb-8">
            <h2 class="text-lg font-bold mb-1 text-white">Status & Duración</h2>
            <p class="text-base">
              <b class={`uppercase ${statusClass}`}>{status}</b>
              - {block.duration}
            </p>
          </div>
        )}
      </div>
    </div>
    <div class="md:w-1/2 animate-on-scroll" data-type="simple" data-duration="1.5" data-easing="Expo.easeOut">
      {teamHTML && (
        <div class="mb-8">
          <h2 class="text-lg font-bold mb-1 text-white">Status & Duración</h2>
          <p class="text-base">
            <b class={`uppercase ${statusClass}`}>{status}</b>{' '}
            - {block.duration}
          </p>
        </div>
      )}
      <div class="md:mb-10">
        <h2 class="text-lg font-bold mb-2 text-white">Overview</h2>
        <div class="text-base text-pretty leading-snug" set:html={overviewHTML} />
      </div>
    </div>
  </div>
</section>
<script is="inline">
  (function () {
    var vm = document.getElementById('viewMore');
    if (!vm) return;
    vm.addEventListener('click', function () {
      var t = document.getElementById('viewMoreText');
      var txt = document.getElementById('text');
      var ic = document.getElementById('viewMoreIcon');
      if (t) t.innerHTML = t.innerHTML.includes('View all') ? 'View less' : 'View all';
      if (txt) txt.classList.toggle('line-clamp-none');
      if (ic) ic.classList.toggle('rotate-180');
    });
  })();
</script>
