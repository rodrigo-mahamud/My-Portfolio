---
import type { StatsBlock } from '../../../utils/payload';

export interface Props {
  block: StatsBlock;
}

const { block } = Astro.props;

// Layout classes
const layoutClasses = {
  grid: 'grid grid-cols-2 md:grid-cols-4 gap-8',
  row: 'flex flex-wrap justify-center gap-8',
  vertical: 'flex flex-col space-y-8'
};
---

<section class="animate-on-scroll px-4 sm:px-6 py-12 mb-8" data-type="simple" data-duration="1.5" data-easing="Expo.easeOut">
  <div class="max-w-6xl mx-auto">
    {block.title && (
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
        {block.title}
      </h2>
    )}
    
    <div class={layoutClasses[block.layout || 'grid']}>
      {block.stats.map((stat, index) => (
        <div key={index} class="text-center">
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">
            {stat.amount}
          </div>
          <h3 class="text-lg font-semibold text-gray-300 mb-2">
            {stat.title}
          </h3>
          {stat.description && (
            <p class="text-sm text-gray-400">
              {stat.description}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>