---
import WorksItem from './WorksItem.astro';
import TitleCentered from '../widgets/TitleCentered.astro';

export interface Props {
  title?: string;
  allPostsText?: string;
  allPostsLink?: string | URL;
  information?: string;
  count?: number; // Optional now since we show all works
}

const { title } = Astro.props;

// Fetch works directly from Payload API following official pattern
const PAYLOAD_API_URL = import.meta.env.PUBLIC_PAYLOAD_URL || 'http://localhost:3000/api';
const res = await fetch(`${PAYLOAD_API_URL}/works?sort=-publishDate`);
const data = await res.json();
const works = data.docs;

---

<section class="py-16 mx-auto max-w-[90vw] w-full lg:max-w-4xl xl:max-w-6xl" id="experiencia">
  <TitleCentered
    data={{
      title: title,
      pretitle: 'Works',
      isSticky: false,
    }}
  />
  <div class="flex flex-col w-full -mb-6">
    {works.map((work) => <WorksItem work={work} />)}
  </div>
</section>
